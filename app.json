{
  "expo": {
    "name": "PG Monitor",
    "slug": "pg-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pg-monitor-icon.png",
    "scheme": "pgmonitor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/pg-monitor-icon.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.veetech.pgmonitor",
      "icon": "./assets/images/pg-monitor-icon.png"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/pg-monitor-notification-icon.png",
          "color": "#0A9B70",
          "defaultChannel": "monitoring-alerts"
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PG Monitor to use Face ID to protect your app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
